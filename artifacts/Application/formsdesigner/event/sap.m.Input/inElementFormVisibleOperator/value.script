if (typeof visibleCondition === "undefined" || visibleCondition === null || visibleCondition === "") {
    return;
}

let formattedText="";
const operators = FORMS.CONDITION_OPERATOR;
Object.getOwnPropertyNames(operators).some(opName=>(operators[opName].key)===visibleCondition?formattedText=operators[opName].title:"");
return formattedText;
